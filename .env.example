DATABASE_URL=postgresql://oma:oma@127.0.0.1:55432/oma_one
PORT=8787
NODE_ENV=development
OMA_DEMO_AUTH=1
# OMA Finance Stage 1. SANDBOX requires an official partner adapter; LIVE is code-locked.
OMA_BANKING_MODE=DEMO
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# OMA_TRUST_PROXY=1
# OMA_AUDIT_HMAC_KEY=replace-via-secret-manager

# Production OIDC/SSO. Demo auth must be disabled in production.
# OMA_OIDC_ISSUER=https://identity.example.com
# OMA_OIDC_CLIENT_ID=oma-one
# OMA_OIDC_CLIENT_SECRET=replace-via-secret-manager
# OMA_OIDC_REDIRECT_URI=https://oma-one.example.com/api/v1/auth/oidc/callback
# OMA_OIDC_ROLES_CLAIM=roles
# OMA_SECURE_COOKIES=1

# S3-compatible object storage for Proof photos.
# OMA_OBJECT_BUCKET=oma-one-proof
# OMA_OBJECT_REGION=eu-central-1
# OMA_OBJECT_ENDPOINT=https://s3.example.com
# OMA_OBJECT_FORCE_PATH_STYLE=0
# OMA_OBJECT_SSE=AES256

# Optional external AI provider.
# OMA_LLM_ENDPOINT=https://provider.example/v1/chat/completions
# OMA_LLM_API_KEY=replace-via-secret-manager
# OMA_LLM_MODEL=model
